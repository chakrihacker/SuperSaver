<p id="notice"><%= notice %></p>

<h1>Conversation Memberships</h1>

<table>
  <thead>
    <tr>
      <th>Conversation</th>
      <th>User</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @conversation_memberships.each do |conversation_membership| %>
      <tr>
        <td><%= conversation_membership.conversation_id %></td>
        <td><%= conversation_membership.user_id %></td>
        <td><%= link_to 'Show', conversation_membership %></td>
        <td><%= link_to 'Edit', edit_conversation_membership_path(conversation_membership) %></td>
        <td><%= link_to 'Destroy', conversation_membership, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Conversation Membership', new_conversation_membership_path %>
